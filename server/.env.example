PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://<host>:<port>/<database>
JWT_SECRET=your_jwt_secret_here
BASE_USER_EMAIL=base@example.com
BASE_USER_PASSWORD=password123
# File storage: set S3_BUCKET to use a bucket instead of the uploads/ folder
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=           # MinIO / R2, e.g. http://localhost:9000
# S3_FORCE_PATH_STYLE=   # true for MinIO
